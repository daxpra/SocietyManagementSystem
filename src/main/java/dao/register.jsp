<!DOCTYPE html>
<html>
<head>
    <title>User Registration</title>
</head>

<body>

<h2>User Registration</h2>

<form action="RegisterServlet" method="post">

    <label>Name:</label>
    <input type="text" name="name" required>

    <br><br>

    <label>Email:</label>
    <input type="email" name="email" required>

    <br><br>

    <button type="submit">Register</button>

</form>

</body>
</html>